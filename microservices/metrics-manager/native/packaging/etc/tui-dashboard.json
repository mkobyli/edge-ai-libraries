  "mouse": true,
  "processes": {
    "maxDisplayed": 10,
    "sortBy": "usage",
    "descending": true
  },
  "alerts": {
    "samplesToRaise": 3,
    "samplesToClear": 3,
    "hysteresisPercent": 5,
    "showCareful": false,
    "maxHistory": 50,
    "bottomBar": true
  },
  "thresholds": {
    "cpu.classPercent": {
      "careful": 65,
      "warning": 75,
      "critical": 85
    },
    "gpu.vramPercent": {
      "careful": 70,
      "warning": 85,
      "critical": 95
    },
    "gpu.processPercent": {
      "careful": 50,
      "warning": 70,
      "critical": 90
    },
    "cpu.totalPercent": {
      "careful": 65,
      "warning": 75,
      "critical": 85
    },
    "cpu.temperatureC": {
      "careful": 70,
      "warning": 85,
      "critical": 95
    },
    "memory.usedPercent": {
      "careful": 50,
      "warning": 70,
      "critical": 90
    },
    "gpu.utilizationPercent": {
      "careful": 50,
      "warning": 70,
      "critical": 90
    },
    "gpu.temperatureC": {
      "careful": 60,
      "warning": 70,
      "critical": 80
    },
    "npu.utilizationPercent": {
      "careful": 50,
      "warning": 70,
      "critical": 90
    },
    "npu.temperatureC": {
      "careful": 70,
      "warning": 85,
      "critical": 95
    },
    "process.cpuPercent": {
      "careful": 50,
      "warning": 70,
      "critical": 90
    }
  }
}
